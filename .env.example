# ControlPlane.ai — optional environment variables.
# Copy to .env for local use. NEVER commit a real .env.
# The prototype needs NO secrets, no API keys and no external services to run.

# --- API layer -------------------------------------------------------------

# Require an X-API-Key header on every request. Unset = authentication disabled
# (the default for local dev and the test suite). /health and /docs stay open.
# CONTROLPLANE_API_KEY=change-me

# CORS allow-list for browser clients (comma-separated). Default: "*".
# CONTROLPLANE_CORS_ORIGINS=http://localhost:3000

# Skip the empirical cost-baseline fit on API startup (faster boot, static baseline).
# CONTROLPLANE_FAST_START=1

# Persist reviewer feedback to a JSONL file (default: in-memory only).
# CONTROLPLANE_FEEDBACK_PATH=data/generated/feedback.jsonl

# --- persistent storage (optional; needs: pip install -r requirements-db.txt) ---

# Enable the SQLAlchemy-backed database/ layer. Off by default -> in-memory managers.
# CONTROLPLANE_PERSISTENCE=1

# Database URL. Default: sqlite:///./controlplane.db  (zero config).
# CONTROLPLANE_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/controlplane

# PostgreSQL connection pool sizing.
# CONTROLPLANE_DB_POOL_SIZE=5
# CONTROLPLANE_DB_MAX_OVERFLOW=10

# --- ports (used by run_app.py) ------------------------------------------

# CONTROLPLANE_UI_PORT=8501
# CONTROLPLANE_API_PORT=8000

# --- Next.js frontend (frontend/.env.local) -----------------------------

# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_API_KEY=            # ships in the browser bundle — prefer the proxy below
# API_PROXY_TARGET=http://api:8000   # server-side /api/* proxy; injects the key privately
