# ---------------------------------------------------------------------------
# ControlPlane.ai frontend — environment
# Copy to .env.local and adjust. NEXT_PUBLIC_* values are exposed to the browser.
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend the browser will call directly.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# API key sent as the X-API-Key header.
#   - Leave BLANK when the backend has CONTROLPLANE_API_KEY unset (default local dev).
#   - If the backend requires a key, prefer the BFF proxy below over shipping the
#     key in the browser bundle.
NEXT_PUBLIC_API_KEY=

# ---- Recommended for production: BFF proxy (key stays server-side) ----------
# When API_PROXY_TARGET is set, next.config.mjs rewrites /api/* -> the backend,
# and the client uses same-origin "/api". Set CONTROLPLANE_API_KEY (server-only,
# no NEXT_PUBLIC_ prefix) so the proxy can inject it.
# API_PROXY_TARGET=http://api:8000
# CONTROLPLANE_API_KEY=change-me
